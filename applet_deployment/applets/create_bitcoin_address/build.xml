<?xml version="1.0" encoding="UTF-8"?>
<project name="CreateBitcoinAddressApplet" default="build" basedir=".">

    <!-- Paths to tools -->
    <property name="tools.dir" value="D:/Personal/monero/javacard_tools"/>
    <property name="sdk.dir" value="${tools.dir}/oracle_javacard_sdks/jc305u3_kit"/>

    <!-- Import ant-javacard task -->
    <taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="${tools.dir}/ant-javacard.jar"/>

    <!-- Regenerates Constants.java and constants.properties from
         ../../constants/create_bitcoin_address.json -- the source of truth
         shared with the Python client (see
         ../../constants/create_bitcoin_address.py and gen_java_constants.py). -->
    <target name="gen-constants">
        <exec executable="python" failonerror="true">
            <arg value="../../constants/gen_java_constants.py"/>
            <arg value="../../constants/create_bitcoin_address.json"/>
            <arg value="com.monero.bitcoin"/>
            <arg value="src/com/monero/bitcoin/Constants.java"/>
            <arg value="constants.properties"/>
        </exec>
        <property file="constants.properties"/>
    </target>

    <target name="build" depends="gen-constants">
        <javacard jckit="${sdk.dir}">
            <cap output="out/create_bitcoin_address.cap"
                 sources="src"
                 aid="A000000001030100"
                 package="com.monero.bitcoin"
                 version="1.0">
                <applet class="com.monero.bitcoin.CreateBitcoinAddressApplet"
                        aid="${aid}"/>
            </cap>
        </javacard>
    </target>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="out"/>
    </target>

</project>
